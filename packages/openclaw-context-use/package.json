{
  "name": "@context-use/openclaw-memory",
  "version": "0.1.0",
  "private": false,
  "description": "OpenClaw memory binding for Context-use",
  "license": "MIT",
  "type": "module",
  "bin": {
    "context-use-openclaw": "./bin.js"
  },
  "files": [
    "bin.js",
    "cli.js",
    "index.js",
    "LICENSE",
    "openclaw.patch.json5",
    "openclaw.plugin.json",
    "README.md",
    "setup.js"
  ],
  "keywords": [
    "active-memory",
    "context-use",
    "memory",
    "openclaw",
    "openclaw-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massimoalbarello/context-use.git",
    "directory": "packages/openclaw-context-use"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "bun test",
    "test": "bun test"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "install": {
      "npmSpec": "@context-use/openclaw-memory",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.7.1"
    },
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": ">=2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1"
    }
  }
}
