{
  "name": "@context-use/database",
  "version": "0.1.96",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./disposable-database": "./src/disposable-database.ts",
    "./publication": "./src/publication/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "initialize": "bun src/initialize.ts",
    "migrate": "bun src/migrate.ts",
    "reset:development": "bun src/reset-development.ts",
    "mark:disposable": "bun src/mark-disposable.ts",
    "seed:test": "bun src/seed-test-state.ts",
    "test:roles": "bun test test/roles.integration.test.ts"
  },
  "dependencies": {
    "@context-use/shared": "workspace:*",
    "entities": "7.0.1",
    "htmlparser2": "10.1.0",
    "marked": "18.0.7",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
