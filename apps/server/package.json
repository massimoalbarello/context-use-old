{
  "name": "@context-use/server",
  "version": "0.1.100",
  "private": true,
  "type": "module",
  "imports": {
    "#development/*": "./src/development/*",
    "#http/*": "./src/http/*",
    "#markdown/*": "./src/markdown/*",
    "#private/*": "./src/private/*",
    "#public/*": "./src/public/*",
    "#storage/*": "./src/storage/*"
  },
  "scripts": {
    "dev": "bun --watch src/development/index.ts",
    "start": "bun src/development/index.ts",
    "start:private": "bun src/private/index.ts",
    "start:public": "bun src/public/index.ts",
    "start:storage": "bun src/storage/index.ts",
    "build": "bun build src/private/index.ts src/public/index.ts src/storage/index.ts src/development/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@better-auth/oauth-provider": "1.7.2",
    "@better-auth/passkey": "1.7.2",
    "@context-use/database": "workspace:*",
    "@context-use/shared": "workspace:*",
    "@elysiajs/static": "1.4.10",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@simplewebauthn/server": "13.3.2",
    "@zip.js/zip.js": "2.8.34",
    "better-auth": "1.7.2",
    "diff": "9.0.0",
    "elysia": "1.4.29",
    "jose": "6.2.8",
    "marked": "18.0.7",
    "pg": "8.22.0",
    "sanitize-html": "2.17.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "@types/sanitize-html": "2.16.1"
  }
}
