{
  "name": "context-use",
  "version": "0.1.97",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "kysely": "0.28.17",
    "nanoid": "3.3.18"
  },
  "scripts": {
    "dev": "bun run --filter '@context-use/*' dev",
    "dev:server": "bun --cwd apps/server dev",
    "dev:web": "bun --cwd apps/web dev",
    "local": "bun scripts/local-stack.ts",
    "build": "bun run --filter '@context-use/*' build",
    "check:all": "bun run check:types && bun run check:codestyle && bun run check:migrations && bun run test:fast",
    "check:codestyle": "bun scripts/check-codestyle.ts",
    "check:codestyle:all": "biome check .",
    "check:migrations": "bun scripts/check-migrations.ts",
    "check:types": "bun run typecheck",
    "fix:codestyle": "bun scripts/check-codestyle.ts --write",
    "typecheck": "bun run --filter '@context-use/*' typecheck",
    "test": "bun run test:fast",
    "test:fast": "bun test apps packages",
    "test:database": "bun test packages/database/test",
    "openclaw:mount": "node packages/openclaw-context-use/bin.js mount --link packages/openclaw-context-use",
    "openclaw:off": "node packages/openclaw-context-use/bin.js off",
    "openclaw:remove": "node packages/openclaw-context-use/bin.js remove",
    "openclaw:status": "node packages/openclaw-context-use/bin.js status",
    "db:bootstrap": "bun apps/server/src/hypermedia-bootstrap-command.ts",
    "db:initialize": "bun --cwd packages/database initialize",
    "db:migrate": "bun --cwd packages/database migrate",
    "db:test": "bun scripts/test-database.ts",
    "db:test:roles": "bun --cwd packages/database test:roles"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "1.3.8",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  }
}
