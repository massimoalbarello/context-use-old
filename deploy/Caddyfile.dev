{
	admin off
	auto_https off
}

:8080 {
	handle /api/auth/* {
		reverse_proxy private-app:3000
	}
	handle /.well-known/oauth-authorization-server {
		reverse_proxy private-app:3000
	}
	handle /.well-known/openid-configuration {
		reverse_proxy private-app:3000
	}
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy private-app:3000
	}
	handle /mcp {
		reverse_proxy private-app:3000 {
			header_up Host localhost:5173
		}
	}
	handle /api/mcp/* {
		reverse_proxy private-app:3000 {
			header_up Host localhost:5173
		}
	}
	handle /api/dashboard/* {
		reverse_proxy private-app:3000
	}
	handle /api/health {
		reverse_proxy private-app:3000
	}
	handle /p/* {
		reverse_proxy public-app:3005
	}
	handle /a/* {
		reverse_proxy public-app:3005
	}
	handle /public.css {
		reverse_proxy public-app:3005
	}
	handle /content.css {
		reverse_proxy public-app:3005
	}
	handle {
		reverse_proxy public-app:3005
	}
}
